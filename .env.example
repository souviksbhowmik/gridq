# Copy to .env and fill in. .env is git-ignored.
# Get these from https://quantum.cloud.ibm.com  (API key + instance CRN)
QISKIT_IBM_TOKEN=
QISKIT_IBM_INSTANCE=
QISKIT_IBM_CHANNEL=ibm_quantum_platform
# Optional: pin a backend. Our allocation: ibm_fez, ibm_kingston, ibm_marrakesh (Heron r2).
# ibm_fez matches the FakeFez noise model used in results/noise.csv. Empty = least busy.
IBM_BACKEND=ibm_fez
